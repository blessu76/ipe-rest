rules_version = '2';
// ipe web — like + comment widget (widget/ipe-engage.js). Anonymous, no login: these rules are the only line of defence.
//   posts/{site}__{post}                 {site, post, count}            like counter: create with 1, afterwards +1 only
//   posts/{site}__{post}/comments/{id}   {name, text, createdAt}        create only (no update, no delete); delete = Firebase console/CLI
// Everything else is denied. Add a site by extending the allow-list in validPid().
service cloud.firestore {
  match /databases/{database}/documents {

    function validPid(pid) {
      return pid.matches('^(ipe\\.rest|idle\\.ipe\\.rest)__[a-z0-9][a-z0-9-]{2,99}$');
    }
    function noLink(s) {
      return !s.matches('(?is).*(https?:|www\\.|://).*');
    }
    function cleanText(s, max) {
      return s is string && s.size() >= 1 && s.size() <= max && s.matches('(?s).*\\S.*') && noLink(s);
    }

    match /posts/{pid} {
      allow get: if validPid(pid);   // no list: posts cannot be enumerated

      allow create: if validPid(pid)
        && request.resource.data.keys().hasOnly(['site', 'post', 'count'])
        && request.resource.data.keys().hasAll(['site', 'post', 'count'])
        && request.resource.data.count == 1
        && pid == request.resource.data.site + '__' + request.resource.data.post;

      allow update: if validPid(pid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1;

      match /comments/{cid} {
        allow get, list: if validPid(pid);
        allow create: if validPid(pid)
          && cid.matches('^[A-Za-z0-9]{10,40}$')
          && request.resource.data.keys().hasOnly(['name', 'text', 'createdAt'])
          && request.resource.data.keys().hasAll(['name', 'text', 'createdAt'])
          && cleanText(request.resource.data.name, 30)
          && cleanText(request.resource.data.text, 500)
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
